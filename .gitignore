__pycache__
.cursorignore
*.log
*.swp
app_info_cache*.json
app_info_cache*.enc*
concepts/_
concepts/i18n/locale
concepts/temp
concepts/negatives.txt
concepts/nsfl*
concepts/nsfw*
concepts/wildcards.txt
configs/*
# src/data/ holds both shipped files and files the app writes at runtime,
# so nothing there is tracked unless it is listed here.
src/data/*
!src/data/blacklist_default.enc
!src/data/config_example.json
!src/data/urban_dictionary.enc
!src/data/workflows/
src/data/workflows/stableDiffusion3*
src/data/workflows/test.json
# The package was sd_runner/ before the move to src/. A checkout updated across
# the move keeps the untracked files it held there, the plain Urban Dictionary
# list among them, which must not be committed.
/sd_runner/
sdg_script.py
scripts/i18n_fixes.json
puns_books*.py
temp*.md
temp*.py
temp*.txt
test_multiselect.py
language_detection_report.json

