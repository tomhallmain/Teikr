__pycache__
.cursorignore
*.log
*.swp
app_info_cache*.json
app_info_cache*.enc*
concepts/_
concepts/i18n/locale
concepts/temp
concepts/negatives.txt
concepts/nsfl*
concepts/nsfw*
concepts/wildcards.txt
configs/*
# src/teikr/data/ holds both shipped files and files the app writes at runtime,
# so nothing there is tracked unless it is listed here.
src/teikr/data/*
!src/teikr/data/blacklist_default.enc
!src/teikr/data/config_example.json
!src/teikr/data/urban_dictionary.enc
!src/teikr/data/workflows/
src/teikr/data/workflows/stableDiffusion3*
src/teikr/data/workflows/test.json
# Earlier homes of the package, sd_runner/ and then src/ itself. A checkout
# updated across a move keeps the untracked files it held there, the plain
# Urban Dictionary list among them, which must not be committed.
/sd_runner/
/src/data/
sdg_script.py
scripts/i18n_fixes.json
puns_books*.py
temp*.md
temp*.py
temp*.txt
test_multiselect.py
language_detection_report.json

# Nuitka build (build_exe.py)
.venv-build/
build/
dist/
